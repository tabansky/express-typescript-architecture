{
  "name": "express-typescript-architecture",
  "version": "0.1.0",
  "description": "Configured express with typescript",
  "main": "build/index.js",
  "scripts": {
    "start": "npm run build && node build/index.js",
    "dev": "nodemon",
    "mocha": "mocha -r ts-node/register -r tsconfig-paths/register 'tests/**/*.test.ts' --exit",
    "test": "npm run migrate && npm run seed && npm run mocha",
    "build": "rm -rf build && tsc && tsc-alias && rm -rf build/tests && mv build/src/** build",
    "lint": "eslint . --ext=.ts",
    "lint:fix": "eslint . --ext=.ts --fix",
    "seed": "knex seed:run --knexfile=knexfile.ts --verbose",
    "migrate": "knex migrate:latest --knexfile=knexfile.ts --verbose",
    "rollback": "knex migrate:rollback --knexfile=knexfile.ts --verbose",
    "make:seeder": "knex seed:make --knexfile=knexfile.ts -x ts --env development",
    "make:migration": "knex migrate:make --knexfile=knexfile.ts -x ts --env development",
    "types": "shx rm -rf src/types/joi && ts-node lib/generate-types.ts"
  },
  "author": "tabansky",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.5",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql": "^2.18.1",
    "nodemailer": "^6.9.14",
    "openapi3-ts": "^4.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "stacktracey": "^2.1.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^1.0.38",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "joi-to-typescript": "^4.14.0",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.4",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "~5.5"
  }
}
